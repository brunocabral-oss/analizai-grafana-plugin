# Grafana Docker Image (e.g., grafana-enterprise, grafana)
GRAFANA_IMAGE=grafana-enterprise

# Grafana Version
GRAFANA_VERSION=13.2.3

# Development mode flag (true/false)
DEVELOPMENT=false

# Enable anonymous authentication (true/false)
ANONYMOUS_AUTH_ENABLED=true

# LLM API Key used in provisioning secureJsonData
LLM_API_KEY=your-api-key-here
